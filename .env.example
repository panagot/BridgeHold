# Get an ingestion key from Torque (MCP: create_api_key, or platform developer settings)
TORQUE_INGEST_API_KEY=

# Default: https://ingest.torque.so
# TORQUE_INGESTER_URL=https://ingest.torque.so

# Must match custom event `eventName` values from your Torque project
TORQUE_EVENT_BRIDGE=bridge_hold_completed
TORQUE_EVENT_SNAPSHOT=bridge_hold_daily_snapshot
